### General Java Ignore Patterns ###
# Compiled class file
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Directory for build outputs
/build/
/target/

# Temporary files
*.tmp
*.temp
*.swp

### IDE Specific Files ###
# IntelliJ IDEA
.idea/
*.iml

# VS Code
.vscode/

# Eclipse
.classpath
.project
.settings/

### Operating System Generated Files ###
# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

.DS_Store
